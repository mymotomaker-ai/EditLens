// Types for the mod (hooks/mod.mjs) in editors and tsc. Claude Code writes them to .claude-plugin/types
// when it loads the mod (not in git); without them this still loads and checks nothing more.
{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "types": []
  },
  "include": ["hooks/**/*.mjs", ".claude-plugin/types/**/*.d.ts"]
}
